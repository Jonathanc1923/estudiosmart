# =============================================================
# ESTUDIO SMART - PLANTILLA DE VARIABLES DE ENTORNO PARA RENDER
# =============================================================

# 1. PUERTO Y URL EXTERNA
PORT=5000
RENDER_EXTERNAL_URL=https://tu-app.onrender.com

# 2. BASE DE DATOS POSTGRESQL EN RENDER
DATABASE_URL=postgres://usuario:password@host.render.com/nombre_db

# 3. MOTOR DE GENERACIÓN IA (REPLICATE)
REPLICATE_API_TOKEN=tu_replicate_api_token

# 4. AUDITORÍA INTELIGENTE DE COMPROBANTES CON IA (GEMINI VISION)
GEMINI_API_KEY=tu_gemini_api_key

# 5. AUTENTICACIÓN GOOGLE OAUTH 2.0
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=https://tu-app.onrender.com/callback

# 6. PANEL DE ADMINISTRACIÓN SECTOR OCULTO (/admi)
ADMIN_PIN=273203

# 7. WHATSAPP OFICIAL DE SOPORTE HUMANO Y VALIDACIÓN
WHATSAPP_PHONE=+51 907 318 642
WHATSAPP_CLEAN=51907318642
